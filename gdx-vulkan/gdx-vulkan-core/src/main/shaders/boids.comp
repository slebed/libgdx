#version 450
#extension GL_GOOGLE_include_directive : require
#define GDX_SKIP_SET0
#include "gdx_vk_common.glsl"

// An example simulation for VulkanGpuInstances (Stress test 5): boids steered by the average of their grid cell. Three dispatches per frame, in order:
//   mode 0  clear the grid (one invocation per uint of it)
//   mode 1  every boid adds its position and velocity to its cell (fixed point, atomics)
//   mode 2  every boid steers toward its cell's centre (cohesion), toward its average velocity (alignment) and away from a crowded cell (separation),
//           swirls around the vertical axis and is pushed back from the edge of the volume, then moves
// A cell has 8 uints: {count, sum position x, y, z, sum velocity x, y, z, -}; the grid is GRID^3 cells in the user region of the world buffer.
//   u_indices = (mode, boid count, instance offset (uints), grid offset (uints))
//   u_custom0 = (dt, half extent of the volume, -, max speed)       u_custom1 = (cohesion, alignment, separation, swirl)
// Instance layout (12 uints): {x, y, z, scale}, {quaternion}, {vx, vy, vz, -}. The quaternion turns +Z to the heading.
layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 1) buffer GdxWorld {
    uint w[];
};

const int GRID = 32;
const float FIX = 256.0;

float f(uint i) {
    return uintBitsToFloat(w[i]);
}

void put(uint i, float v) {
    w[i] = floatBitsToUint(v);
}

uint cellOf(vec3 p, float halfExtent) {
    const ivec3 c = clamp(ivec3((p + halfExtent) / (2.0 * halfExtent) * float(GRID)), ivec3(0), ivec3(GRID - 1));
    return uint(c.x + GRID * (c.y + GRID * c.z));
}

void main() {
    const int mode = gdx_pc.u_indices.x;
    const uint grid = uint(gdx_pc.u_indices.w);
    const uint i = gl_GlobalInvocationID.x;
    if (mode == 0) {
        if (i < uint(GRID * GRID * GRID * 8)) w[grid + i] = 0u;
        return;
    }
    if (i >= uint(gdx_pc.u_indices.y)) return;
    const uint b = uint(gdx_pc.u_indices.z) + i * 12u;
    vec3 p = vec3(f(b), f(b + 1u), f(b + 2u));
    vec3 v = vec3(f(b + 8u), f(b + 9u), f(b + 10u));
    const float halfExtent = gdx_pc.u_custom0.y;
    const uint cell = grid + cellOf(p, halfExtent) * 8u;

    if (mode == 1) {
        atomicAdd(w[cell], 1u);
        atomicAdd(w[cell + 1u], uint(int(p.x * FIX)));
        atomicAdd(w[cell + 2u], uint(int(p.y * FIX)));
        atomicAdd(w[cell + 3u], uint(int(p.z * FIX)));
        atomicAdd(w[cell + 4u], uint(int(v.x * FIX)));
        atomicAdd(w[cell + 5u], uint(int(v.y * FIX)));
        atomicAdd(w[cell + 6u], uint(int(v.z * FIX)));
        return;
    }

    const float dt = gdx_pc.u_custom0.x, maxSpeed = gdx_pc.u_custom0.w;
    const float cohesion = gdx_pc.u_custom1.x, alignment = gdx_pc.u_custom1.y, separation = gdx_pc.u_custom1.z, swirl = gdx_pc.u_custom1.w;
    const float n = float(w[cell]);
    vec3 steer = vec3(0.0);
    if (n > 1.0) {
        const vec3 centre = vec3(int(w[cell + 1u]), int(w[cell + 2u]), int(w[cell + 3u])) / (FIX * n);
        const vec3 avgVel = vec3(int(w[cell + 4u]), int(w[cell + 5u]), int(w[cell + 6u])) / (FIX * n);
        const float crowd = clamp((n - 6.0) / 10.0, 0.0, 1.0);
        steer += (centre - p) * cohesion + (avgVel - v) * alignment + (p - centre) * separation * (0.2 + crowd);
    }
    steer += vec3(-p.z, 0.0, p.x) * swirl / (length(p.xz) + 10.0);
    const float r = length(p);
    if (r > 0.8 * halfExtent) steer -= p / r * (r - 0.8 * halfExtent) * 0.5;

    v += steer * dt;
    const float speed = length(v);
    if (speed > 1e-4) v *= clamp(speed, 0.4 * maxSpeed, maxSpeed) / speed;
    else v = vec3(0.0, 0.0, maxSpeed);
    p += v * dt;

    put(b, p.x);
    put(b + 1u, p.y);
    put(b + 2u, p.z);
    put(b + 8u, v.x);
    put(b + 9u, v.y);
    put(b + 10u, v.z);
    // The rotation taking +Z to the heading.
    const vec3 dir = normalize(v);
    vec4 q = vec4(cross(vec3(0.0, 0.0, 1.0), dir), 1.0 + dir.z);
    q = q.w < 1e-4 ? vec4(1.0, 0.0, 0.0, 0.0) : normalize(q);
    put(b + 4u, q.x);
    put(b + 5u, q.y);
    put(b + 6u, q.z);
    put(b + 7u, q.w);
}
