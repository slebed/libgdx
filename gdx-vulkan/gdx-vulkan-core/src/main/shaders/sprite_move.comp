#version 450
#extension GL_GOOGLE_include_directive : require
#define GDX_SKIP_SET0
#include "gdx_vk_common.glsl"

// VulkanSpriteBatchInstanced: moves every sprite and bounces it inside the bounds. One vec4 per sprite: (x, y, vx, vy), the sprite's
// lower-left corner and its velocity.
//   u_indices.x = sprite count          u_custom0 = (dt, boundsWidth, boundsHeight, gravityY)
//   u_custom1.xy = sprite size
layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 1) buffer GdxSprites {
    vec4 sprites[];
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(gdx_pc.u_indices.x)) return;

    float dt = gdx_pc.u_custom0.x;
    vec2 maxPos = max(gdx_pc.u_custom0.yz - gdx_pc.u_custom1.xy, vec2(0.0));
    vec4 s = sprites[i];
    vec2 p = s.xy;
    vec2 v = s.zw;

    v.y += gdx_pc.u_custom0.w * dt;
    p += v * dt;

    // Reflect off the walls (a sprite that overshoots by less than a bounds width comes back the same distance).
    if (p.x < 0.0) {
        p.x = -p.x;
        v.x = abs(v.x);
    } else if (p.x > maxPos.x) {
        p.x = 2.0 * maxPos.x - p.x;
        v.x = -abs(v.x);
    }
    if (p.y < 0.0) {
        p.y = -p.y;
        v.y = abs(v.y);
    } else if (p.y > maxPos.y) {
        p.y = 2.0 * maxPos.y - p.y;
        v.y = -abs(v.y);
    }
    p = clamp(p, vec2(0.0), maxPos);

    sprites[i] = vec4(p, v);
}
